{
    "name": "tobento/service-pdf",
    "version": "2.0.1",
    "type": "library",
    "description": "A flexible and extensible PDF generation service built around clean interfaces and parameter objects.",
    "keywords": [
        "tobento",
        "package",
        "pdf"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "mpdf/mpdf": "^8.2",
        "tobento/service-autowire": "^2.0",
        "tobento/service-view": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "tijsverkoyen/css-to-inline-styles": "^2.3"
    },
    "suggest": {
        "tobento/service-container": "May be used for LazyPdfGenerators"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "nyholm/psr7": "^1.8",
        "tobento/service-container": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Pdf\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Pdf\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}